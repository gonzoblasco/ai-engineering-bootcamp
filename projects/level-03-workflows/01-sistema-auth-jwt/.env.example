# Copia este archivo a .env y rellena los valores

# Puerto del servidor
PORT=3000

# Secreto para firmar JWT (usa una cadena larga y aleatoria en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Expiración del access token
JWT_ACCESS_EXPIRES_IN=15m

# Expiración del refresh token (en segundos; 7 días = 604800)
REFRESH_TOKEN_EXPIRES_SECONDS=604800

# URL de la base de datos SQLite
DATABASE_URL="file:./dev.db"
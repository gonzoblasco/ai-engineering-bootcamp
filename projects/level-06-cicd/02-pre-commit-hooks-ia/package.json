{
  "name": "pre-commit-hooks-ia",
  "version": "1.0.0",
  "description": "Hook de pre-commit para validar cambios con IA",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "prepare": "husky",
    "dev": "node --watch src/index.js",
    "validate": "node scripts/validate-with-ia.js",
    "validate:staged": "lint-staged",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "pre-commit",
    "husky",
    "lint-staged",
    "ia",
    "node"
  ],
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.16.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write",
      "node scripts/validate-with-ia.js"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}

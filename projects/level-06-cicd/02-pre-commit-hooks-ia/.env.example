# Configuración del servicio de IA para el pre-commit hook
#
# Copia este archivo como .env y configura tus credenciales:
#   cp .env.example .env

# API key para el servicio de IA (OpenAI, Anthropic, Groq, etc.)
# Si no se configura, el validador usará patrones regex como fallback.
AI_API_KEY=

# URL del endpoint de IA compatible con OpenAI
# Por defecto: https://api.openai.com/v1/chat/completions
# AI_API_URL=https://api.openai.com/v1/chat/completions

# Modelo de IA a utilizar
# Por defecto: gpt-4o-mini
# AI_MODEL=gpt-4o-mini

# Temperatura para las respuestas (0 = determinista)
# AI_TEMPERATURE=0

# Timeout en milisegundos para las llamadas a la API
# AI_TIMEOUT_MS=30000

+++ b/src/format.test.js
@@ -0,0 +1,15 @@
+const { formatCurrency, formatDate } = require("./format");
+
+test("formatCurrency formatea pesos argentinos", () => {
+  expect(formatCurrency(1234.5)).toBe("$ 1.234,50");
+});
+
+test("formatCurrency maneja cero", () => {
+  expect(formatCurrency(0)).toBe("$ 0,00");
+});
+
+test("formatDate formatea una fecha", () => {
+  const d = new Date(2026, 7, 3);
+  expect(formatDate(d)).toBe("3/8/2026");
+});

+function processOrder(order) {
+  let total = 0;
+  let items = order.items;
+  let i = 0;
+  while (i < items.length) {
+    let item = items[i];
+    let price = item.price;
+    let qty = item.quantity;
+    let lineTotal = price * qty;
+    let discount = 0;
+    if (qty > 10) {
+      discount = 0.1;
+    }
+    let applied = lineTotal - lineTotal * discount;
+    total = total + applied;
+    i = i + 1;
+  }
+  let tax = total * 0.21;
+  let shipping = 0;
+  if (total < 500) {
+    shipping = 99;
+  }
+  let grandTotal = total + tax + shipping;
+  let result = {};
+  result.total = total;
+  result.tax = tax;
+  result.shipping = shipping;
+  result.grandTotal = grandTotal;
+  result.itemsCount = order.items.length;
+  result.average = total / order.items.length;
+  result.isBulk = order.items.length > 10;
+  result.isEligible = total > 1000;
+  result.category = "standard";
+  if (total > 5000) {
+    result.category = "premium";
+  }
+  if (order.priority) {
+    result.priority = true;
+    result.shipping = 0;
+  }
+  return result;
+}
+
+module.exports = { processOrder };
